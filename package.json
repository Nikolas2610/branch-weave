{
  "name": "branch-lens",
  "displayName": "BranchWeave",
  "description": "Compare a reference branch with your current working files, review changes, and copy lines or sections in VS Code.",
  "version": "0.2.0",
  "publisher": "Nikolas2610",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview tests",
    "test": "tsx --test tests/*.test.ts && node --test \"scripts/*.test.cjs\"",
    "package": "vsce package --no-dependencies --out branch-lens.vsix",
    "test:host": "node scripts/smoke-host.mjs",
    "vscode:prepublish": "npm run build",
    "package:list": "vsce ls --no-dependencies"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "4.0.1-4",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "ovsx": "1.3.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchlens",
          "title": "BranchWeave",
          "icon": "media/branchlens.svg"
        }
      ]
    },
    "views": {
      "branchlens": [
        {
          "id": "branchlens.compare",
          "name": "Compare Branches",
          "type": "webview"
        },
        {
          "id": "branchlens.files",
          "name": "Changed Files",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "branchlens.repository",
        "title": "BranchWeave: Select Repository"
      },
      {
        "command": "branchlens.left",
        "title": "BranchWeave: Select Left Branch"
      },
      {
        "command": "branchlens.compare",
        "title": "BranchWeave: Compare Branches"
      },
      {
        "command": "branchlens.refresh",
        "title": "BranchWeave: Refresh Comparison"
      },
      {
        "command": "branchlens.upstream",
        "title": "BranchWeave: Toggle Upstream Comparison"
      },
      {
        "command": "branchlens.highlight",
        "title": "BranchWeave: Toggle Changed-Line Highlighting"
      },
      {
        "command": "branchlens.flat",
        "title": "BranchWeave: Toggle Flat List"
      },
      {
        "command": "branchlens.open",
        "title": "BranchWeave: Open Changed File"
      },
      {
        "command": "branchlens.nextFile",
        "title": "BranchWeave: Next Changed File"
      },
      {
        "command": "branchlens.previousFile",
        "title": "BranchWeave: Previous Changed File"
      },
      {
        "command": "branchlens.nextHunk",
        "title": "BranchWeave: Next Change Section"
      },
      {
        "command": "branchlens.previousHunk",
        "title": "BranchWeave: Previous Change Section"
      },
      {
        "command": "branchlens.focusLeft",
        "title": "BranchWeave: Focus Left Editor"
      },
      {
        "command": "branchlens.focusRight",
        "title": "BranchWeave: Focus Right Editor"
      },
      {
        "command": "branchlens.transferLine",
        "title": "BranchWeave: Transfer Selected Line"
      },
      {
        "command": "branchlens.transferHunk",
        "title": "BranchWeave: Transfer Current Section"
      },
      {
        "command": "branchlens.undo",
        "title": "BranchWeave: Undo Draft Edit"
      },
      {
        "command": "branchlens.redo",
        "title": "BranchWeave: Redo Draft Edit"
      },
      {
        "command": "branchlens.reset",
        "title": "BranchWeave: Reset Side"
      },
      {
        "command": "branchlens.export",
        "title": "BranchWeave: Export Patch"
      },
      {
        "command": "branchlens.apply",
        "title": "BranchWeave: Apply Draft to Working Tree"
      },
      {
        "command": "branchlens.focusFiles",
        "title": "BranchWeave: Focus Changed Files"
      },
      {
        "command": "branchlens.fileOperation",
        "title": "BranchWeave: Draft File Operation"
      },
      {
        "command": "branchlens.save",
        "title": "BranchWeave: Save Current Working File"
      }
    ],
    "keybindings": [
      {
        "command": "branchlens.nextFile",
        "key": "alt+shift+pagedown",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.previousFile",
        "key": "alt+shift+pageup",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.nextHunk",
        "key": "alt+shift+down",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.previousHunk",
        "key": "alt+shift+up",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.focusFiles",
        "key": "alt+shift+f",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.focusLeft",
        "key": "alt+shift+1",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.focusRight",
        "key": "alt+shift+2",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.upstream",
        "key": "alt+shift+u",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.refresh",
        "key": "alt+shift+c",
        "when": "branchlens.active"
      },
      {
        "command": "branchlens.transferLine",
        "key": "alt+shift+right",
        "when": "branchlens.active",
        "args": "left"
      },
      {
        "command": "branchlens.transferLine",
        "key": "alt+shift+left",
        "when": "branchlens.active",
        "args": "right"
      },
      {
        "command": "branchlens.transferHunk",
        "key": "alt+shift+l",
        "when": "branchlens.active",
        "args": "left"
      },
      {
        "command": "branchlens.transferHunk",
        "key": "alt+shift+r",
        "when": "branchlens.active",
        "args": "right"
      },
      {
        "command": "branchlens.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "branchlens.active"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branchlens.refresh",
          "when": "view == branchlens.files",
          "group": "navigation"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "BranchWeave requires trusted access to local Git and working-tree files."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "BranchWeave needs a local Git working tree."
    }
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "@azure/msal-node": "^7.1.1"
  },
  "author": "Nikolas Psyllou",
  "homepage": "https://github.com/Nikolas2610/branch-weave#readme",
  "bugs": {
    "url": "https://github.com/Nikolas2610/branch-weave/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikolas2610/branch-weave.git"
  },
  "keywords": [
    "git",
    "branch",
    "diff",
    "compare",
    "merge",
    "working tree"
  ],
  "private": false
}
