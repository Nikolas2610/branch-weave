{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "webview/**/*.ts", "tests/**/*.ts"]
}
